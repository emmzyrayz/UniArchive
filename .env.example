# Copy to .env.local and fill in. Never commit real values.

# --- Site URL ------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap, robots and
# every link in emails (src/lib/seo.ts). Production: https://uniarchive.com.ng
# Local: http://localhost:3000. If unset on Vercel, the project's production
# domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_APP_URL=https://uniarchive.com.ng

# Google Search Console "HTML tag" verification code (just the content value).
# Leave empty to omit the <meta name="google-site-verification"> tag.
GOOGLE_SITE_VERIFICATION=

# --- Database / cache ----------------------------------------------------
MONGODB_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ----------------------------------------------------------------
# At least 32 characters
JWT_SECRET=
# Field encryption (AES-256) and lookup-hash salt; changing these makes
# existing encrypted data unreadable
ENCRYPTION_KEY=
HASH_SALT=

# Google sign-in (Auth.js). Must match the canonical domain in production;
# Google redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=https://uniarchive.com.ng
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------
# Transactional email (codes, verification, notices) goes through ZeptoMail
# SMTP from no-reply@uniarchive.com.ng (src/lib/mailConfig.ts). In ZeptoMail:
# Mail Agents -> your agent -> SMTP; the username is the literal word
# "emailapikey" and the password is that agent's SMTP token. The
# uniarchive.com.ng domain must be verified there (SPF + DKIM records).
# Test with: pnpm email:test uniarchive.team@gmail.com
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
# "true" for implicit TLS on port 465; false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=
# Defaults to "UniArchive <no-reply@uniarchive.com.ng>"
MAIL_FROM=
# Where replies go. Defaults to support@uniarchive.com.ng
MAIL_REPLY_TO=

# Contact-form messages go to support@uniarchive.com.ng, which the domain's
# mail forwarder delivers to the team's Gmail inbox. Set this only to send
# them somewhere else (e.g. testing locally).
CONTACT_EMAIL=

# Bulk email (announcements, newsletter) goes through Brevo, never ZeptoMail
# (its terms forbid bulk mail). BREVO_API_KEY: Brevo > SMTP & API > API keys.
# BREVO_WEBHOOK_SECRET: any long random string; Brevo calls
# https://uniarchive.com.ng/api/webhooks/brevo?token=<it> on unsubscribes
# (Campaigns > Settings > Webhooks: "Unsubscribed" and "Marked as spam").
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
# Vercel Cron (vercel.json) calls the /api/cron/* routes with
# "Authorization: Bearer <CRON_SECRET>": purge-accounts daily (erases
# accounts whose 7-day deletion grace period has ended), drive-inbox daily
# (imports PDFs shared with UniArchive's Google account) and
# tidy-brevo-lists weekly (deletes old broadcast lists in Brevo). Any long
# random string; Vercel sends it automatically once it's set in the
# project's env.
CRON_SECRET=

# Optional: who broadcasts come from (the address must be a verified sender
# in Brevo). Defaults: "UniArchive" <updates@uniarchive.com.ng>.
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# --- Storage -------------------------------------------------------------
# Cloudinary: PDFs up to 10 MB, reader page images, avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backblaze B2 (S3-compatible): PDFs over 10 MB
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_REGION=
BACKBLAZE_ENDPOINT=
BACKBLAZE_PUBLIC_URL=

# --- Google Drive import (lib/drive) ------------------------------------
# GOOGLE_DRIVE_API_KEY: reads files shared "Anyone with the link" (public
# link import). Google Cloud > APIs & Services: enable the Google Drive API,
# create an API key restricted to the Drive API. Without it link import
# answers "isn't set up yet".
GOOGLE_DRIVE_API_KEY=
# The Google Picker ("From my Drive"): enable the Google Picker API too,
# create a browser API key restricted to the Picker API and your site's
# domains, and add your site to the Authorized JavaScript origins of the
# GOOGLE_CLIENT_ID OAuth client. Add the drive.file scope to the OAuth
# consent screen. GOOGLE_CLOUD_PROJECT_NUMBER: Cloud console > Dashboard.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# The platform Drive inbox (/admin/materials/drive-inbox): a separate
# OAuth client (Web application) with the Drive read-only scope, published
# (not "Testing"), redirect URI <site>/api/admin/drive-inbox/callback.
# PLATFORM_DRIVE_EMAIL: the Google account people share PDFs with; the
# inbox refuses to connect any other.
DRIVE_INBOX_CLIENT_ID=
DRIVE_INBOX_CLIENT_SECRET=
PLATFORM_DRIVE_EMAIL=
# Tests only: fake Google OAuth endpoints. Leave unset.
DRIVE_OAUTH_TOKEN_URL=
DRIVE_OAUTH_REVOKE_URL=
# DRIVE_API_URL: tests only, points the Drive client at a fake server
# (default https://www.googleapis.com/drive/v3). Leave unset.
DRIVE_API_URL=

# --- PDF worker (services/pdf-worker) ----------------------------------
# Shared secret the worker signs its requests with (at least 32 characters,
# e.g. openssl rand -hex 32). The same value goes in the worker's Render
# environment. Unset: the worker routes are off and PDF jobs just queue up.
PDF_WORKER_SECRET=

# --- Development only ----------------------------------------------------
# Turns on mock mode with this role, e.g. "student" (src/lib/mockMode.ts)
# NEXT_PUBLIC_MOCK_ROLE=

# Dev mode (local only): while running `pnpm dev` on localhost, every request
# counts as signed in as this account (its upid), so you never get logged out
# while working. Ignored in production builds, on Vercel and from other
# devices on your network. See src/lib/auth/devAuth.ts.
DEV_USER_UPID=
