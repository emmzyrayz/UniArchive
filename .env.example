# Copy to .env.local and fill in. Never commit real values.

# --- Site URL ------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap, robots and
# every link in emails (src/lib/seo.ts). Production: https://www.uniarchive.com.ng
# Local: http://localhost:3000. If unset on Vercel, the project's production
# domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_APP_URL=https://www.uniarchive.com.ng

# Google Search Console "HTML tag" verification code (just the content value).
# Leave empty to omit the <meta name="google-site-verification"> tag.
GOOGLE_SITE_VERIFICATION=

# --- Database / cache ----------------------------------------------------
MONGODB_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ----------------------------------------------------------------
# At least 32 characters
JWT_SECRET=
# Field encryption (AES-256) and lookup-hash salt; changing these makes
# existing encrypted data unreadable
ENCRYPTION_KEY=
HASH_SALT=

# Google sign-in (Auth.js). Must match the canonical domain in production;
# Google redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=https://www.uniarchive.com.ng
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (any SMTP provider) -----------------------------------------
# Every email is sent from MAIL_FROM with Reply-To MAIL_REPLY_TO
# (src/lib/mailConfig.ts). Test with: pnpm email:test you@example.com
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS on port 465; leave unset/false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UniArchive <noreply@uniarchive.com.ng>"
# Defaults to support@uniarchive.com.ng (SUPPORT_EMAIL in src/lib/site.ts)
MAIL_REPLY_TO=

# Example values for ZeptoMail (Mail Agent -> SMTP). The username is the
# literal word "emailapikey"; the password is the Mail Agent's SMTP token.
# MAIL_FROM must be on a domain verified in ZeptoMail.
# SMTP_HOST=smtp.zeptomail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=emailapikey
# SMTP_PASS=<your ZeptoMail Send Mail token>
# MAIL_FROM="UniArchive <noreply@uniarchive.com.ng>"
# MAIL_REPLY_TO=support@uniarchive.com.ng

# Legacy Gmail sending, used only while SMTP_* is unset. Remove after the
# switch to ZeptoMail.
EMAIL_USER=
EMAIL_PASS=

# Where contact-form messages are delivered. Falls back to EMAIL_USER, then
# support@uniarchive.com.ng (which needs a real inbox: ZeptoMail only sends).
CONTACT_EMAIL=

# --- Storage -------------------------------------------------------------
# Cloudinary: PDFs up to 10 MB, reader page images, avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backblaze B2 (S3-compatible): PDFs over 10 MB
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_REGION=
BACKBLAZE_ENDPOINT=
BACKBLAZE_PUBLIC_URL=

# --- Development only ----------------------------------------------------
# Turns on mock mode with this role, e.g. "student" (src/lib/mockMode.ts)
# NEXT_PUBLIC_MOCK_ROLE=
