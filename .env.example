# Copy to .env.local and fill in. Never commit real values.

# --- Site URL ------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap, robots and
# every link in emails (src/lib/seo.ts). Production: https://www.uniarchive.com.ng
# Local: http://localhost:3000. If unset on Vercel, the project's production
# domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
NEXT_PUBLIC_APP_URL=https://www.uniarchive.com.ng

# Google Search Console "HTML tag" verification code (just the content value).
# Leave empty to omit the <meta name="google-site-verification"> tag.
GOOGLE_SITE_VERIFICATION=

# --- Database / cache ----------------------------------------------------
MONGODB_URI=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ----------------------------------------------------------------
# At least 32 characters
JWT_SECRET=
# Field encryption (AES-256) and lookup-hash salt; changing these makes
# existing encrypted data unreadable
ENCRYPTION_KEY=
HASH_SALT=

# Google sign-in (Auth.js). Must match the canonical domain in production;
# Google redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=https://www.uniarchive.com.ng
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------
# Transactional email (codes, verification, notices) goes through ZeptoMail
# SMTP from no-reply@uniarchive.com.ng (src/lib/mailConfig.ts). In ZeptoMail:
# Mail Agents -> your agent -> SMTP; the username is the literal word
# "emailapikey" and the password is that agent's SMTP token. The
# uniarchive.com.ng domain must be verified there (SPF + DKIM records).
# Test with: pnpm email:test uniarchive.team@gmail.com
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
# "true" for implicit TLS on port 465; false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=
# Defaults to "UniArchive <no-reply@uniarchive.com.ng>"
MAIL_FROM=
# Where replies go. Defaults to support@uniarchive.com.ng
MAIL_REPLY_TO=

# Contact-form messages go to support@uniarchive.com.ng, which the domain's
# mail forwarder delivers to the team's Gmail inbox. Set this only to send
# them somewhere else (e.g. testing locally).
CONTACT_EMAIL=

# Legacy Gmail sending, used only while SMTP_* is unset. Delete both once
# ZeptoMail is set up in every environment.
EMAIL_USER=
EMAIL_PASS=

# --- Storage -------------------------------------------------------------
# Cloudinary: PDFs up to 10 MB, reader page images, avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backblaze B2 (S3-compatible): PDFs over 10 MB
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_REGION=
BACKBLAZE_ENDPOINT=
BACKBLAZE_PUBLIC_URL=

# --- PDF worker (services/pdf-worker) ----------------------------------
# Shared secret the worker signs its requests with (at least 32 characters,
# e.g. openssl rand -hex 32). The same value goes in the worker's Render
# environment. Unset: the worker routes are off and PDF jobs just queue up.
PDF_WORKER_SECRET=

# --- Development only ----------------------------------------------------
# Turns on mock mode with this role, e.g. "student" (src/lib/mockMode.ts)
# NEXT_PUBLIC_MOCK_ROLE=
